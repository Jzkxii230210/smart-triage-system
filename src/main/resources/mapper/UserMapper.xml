<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjsru.mapper.UserMapper">
    <resultMap id="UserResultMap" type="com.zjsru.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
    </resultMap>

    <resultMap id="UserDTOResultMap" type="com.zjsru.entity.dto.UserDTO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="realName" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 根据用户名和密码查询用户 -->
    <select id="getByUsernameAndPassword" parameterType="map" resultType="com.zjsru.entity.User">
        SELECT id, username, password, role
        FROM sys_user
        WHERE username = #{username} AND password = #{password}
    </select>

    <!-- 查询用户列表 -->
    <select id="selectUserList" parameterType="map" resultType="com.zjsru.entity.dto.UserDTO">
        SELECT id, username, password, role
        FROM sys_user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!-- 关联查询用户信息 -->
    <select id="selectUserDTOList" parameterType="map" resultType="com.zjsru.entity.dto.UserDTO">
        SELECT
        u.id,
        u.username,
        u.password,
        u.role,
        CASE
        WHEN u.role = 'doctor' THEN d.real_name
        WHEN u.role = 'patient' THEN p.real_name
        ELSE u.username
        END AS realName,
        CASE
        WHEN u.role = 'patient' THEN p.phone
        END AS phone
        FROM sys_user u
        LEFT JOIN sys_doctor d ON u.username = d.username
        LEFT JOIN sys_patient p ON u.username = p.username
        <where>
            <if test="username != null and username != ''">
                AND u.username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="role != null and role != ''">
                AND u.role = #{role}
            </if>
        </where>
    </select>

    <!-- 新增用户 -->
    <insert id="insertUser" parameterType="com.zjsru.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, role)
        VALUES (#{username}, #{password}, #{role})
    </insert>

    <!-- 更新用户 -->
    <update id="updateUser" parameterType="com.zjsru.entity.User">
        UPDATE sys_user
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="role != null and role != ''">
                role = #{role},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除用户 -->
    <delete id="deleteUserById" parameterType="int">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

    <!-- 更新密码 -->
    <update id="updatePassword" parameterType="map">
        UPDATE sys_user SET password = #{password} WHERE id = #{id}
    </update>

    <!-- 更新医生表用户名 -->
    <update id="updateDoctorUsername" parameterType="map">
        UPDATE sys_doctor SET username = #{newUsername} WHERE username = #{oldUsername}
    </update>

    <!-- 更新患者表用户名 -->
    <update id="updatePatientUsername" parameterType="map">
        UPDATE sys_patient SET username = #{newUsername} WHERE username = #{oldUsername}
    </update>

    <!-- 根据ID查询用户 -->
    <select id="selectById" parameterType="int" resultType="com.zjsru.entity.User">
        SELECT id, username, password, role
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultType="com.zjsru.entity.User">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <select id="findByEmail" resultType="com.zjsru.entity.User">
        SELECT * FROM sys_user WHERE email = #{email}
    </select>

</mapper>
