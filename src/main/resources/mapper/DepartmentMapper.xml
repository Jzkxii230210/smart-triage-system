<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjsru.mapper.DepartmentMapper">

    <select id="selectAll" resultType="com.zjsru.entity.Department">
        SELECT id, name, description FROM sys_dept
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_dept (name, description)
        VALUES (#{name}, #{description})
    </insert>

    <update id="update">
        UPDATE sys_dept
        SET name = #{name},
            description = #{description}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_dept WHERE id = #{id}
    </delete>

    <select id="selectAllDeptNames" resultType="java.lang.String">
        SELECT name FROM sys_dept
    </select>

</mapper>