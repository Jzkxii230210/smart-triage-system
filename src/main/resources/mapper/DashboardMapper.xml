<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zjsru.mapper.DashboardMapper">

    <!-- 科室信息查询 -->
    <select id="selectDepts" resultType="com.zjsru.entity.vo.DashboardVO$DeptVO">
        SELECT name, icon
        FROM sys_dept
    </select>

    <!-- 公告信息查询 -->
    <select id="selectNotices" resultType="com.zjsru.entity.vo.DashboardVO$NoticeVO">
        SELECT id, title, type as tag
        FROM sys_notice
        ORDER BY create_time DESC
        LIMIT 5
    </select>

    <!-- 推荐医生查询 -->
    <select id="selectRecommendDoctors" resultType="com.zjsru.entity.vo.DashboardVO$DoctorVO">
        SELECT
            d.id,
            d.real_name as name,
            dp.name as deptName,
            d.title,
            d.expertise
        FROM sys_doctor d
                 LEFT JOIN sys_dept dp ON d.dept_id = dp.id
        LIMIT 3
    </select>

</mapper>
